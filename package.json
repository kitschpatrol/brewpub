{
	"name": "brewpub",
	"version": "0.0.0",
	"description": "A cli+library project.",
	"keywords": [
		"cli",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/brewpub",
	"bugs": "https://github.com/kitschpatrol/brewpub/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/brewpub.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"brewpub": "dist/bin/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/node": "~24.13.4",
		"@types/yargs": "^17.0.35",
		"lognow": "^0.8.3",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.9.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.2.0",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.4.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
